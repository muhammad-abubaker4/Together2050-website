{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        }
      ]
    }
  ],
  "redirects": [
    { "source": "/team/core-team", "destination": "/team/", "permanent": true },
    { "source": "/team/core-team/", "destination": "/team/", "permanent": true },
    { "source": "/contact", "destination": "/get-involved/#contact", "permanent": true },
    { "source": "/contact/", "destination": "/get-involved/#contact", "permanent": true },
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/about.html", "destination": "/about/", "permanent": true },
    { "source": "/vision.html", "destination": "/vision/", "permanent": true },
    { "source": "/what-we-do.html", "destination": "/what-we-do/", "permanent": true },
    { "source": "/team.html", "destination": "/team/", "permanent": true },
    { "source": "/team/advisory-council.html", "destination": "/team/advisory-council/", "permanent": true },
    { "source": "/collaborate.html", "destination": "/collaborate/", "permanent": true },
    { "source": "/get-involved.html", "destination": "/get-involved/", "permanent": true },
    { "source": "/events/the-cost-of-perfection.html", "destination": "/events/the-cost-of-perfection/", "permanent": true },
    { "source": "/about/index.html", "destination": "/about/", "permanent": true },
    { "source": "/vision/index.html", "destination": "/vision/", "permanent": true },
    { "source": "/what-we-do/index.html", "destination": "/what-we-do/", "permanent": true },
    { "source": "/team/index.html", "destination": "/team/", "permanent": true },
    { "source": "/team/advisory-council/index.html", "destination": "/team/advisory-council/", "permanent": true },
    { "source": "/collaborate/index.html", "destination": "/collaborate/", "permanent": true },
    { "source": "/get-involved/index.html", "destination": "/get-involved/", "permanent": true },
    { "source": "/events/the-cost-of-perfection/index.html", "destination": "/events/the-cost-of-perfection/", "permanent": true },
    { "source": "/about", "destination": "/about/", "permanent": true },
    { "source": "/vision", "destination": "/vision/", "permanent": true },
    { "source": "/what-we-do", "destination": "/what-we-do/", "permanent": true },
    { "source": "/team", "destination": "/team/", "permanent": true },
    { "source": "/team/advisory-council", "destination": "/team/advisory-council/", "permanent": true },
    { "source": "/collaborate", "destination": "/collaborate/", "permanent": true },
    { "source": "/get-involved", "destination": "/get-involved/", "permanent": true },
    { "source": "/events/the-cost-of-perfection", "destination": "/events/the-cost-of-perfection/", "permanent": true }
  ]
}
